# Copy to .env. Without NEBIUS_API_KEY the app runs in stub mode with simulated answers.
NEBIUS_API_KEY=
# Required with a key: live calls stop before total estimated spend would pass this (USD). Spend is kept in .apprentice-ledger.jsonl.
APPRENTICE_BUDGET_USD=0.90
# Fine-tuning stays refused until a price quote is approved and set here (USD).
# APPRENTICE_FINETUNE_QUOTE_USD=
# Optional: lets the teacher use real wording found on the web.
TAVILY_API_KEY=
# Optional model overrides.
# APPRENTICE_STUDENT=Qwen/Qwen3-30B-A3B-Instruct-2507
# APPRENTICE_TEACHER=nvidia/Nemotron-3-Ultra-550b-a55b
# APPRENTICE_GRADER=nvidia/nemotron-3-super-120b-a12b
